{
  "name": "fsdh-user-docs",
  "description": "User documentation for the Federal Science DataHub platform",
  "version": "0.0.1",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "docs:build": "vuepress build docs",
    "docs:clean-dev": "vuepress dev docs --clean-cache",
    "docs:dev": "vuepress dev docs",
    "docs:update-package": "npx vp-update",
    "docs:check-links": "linkinator \"docs/{en,fr}/**/*.md\" --markdown --verbosity info --concurrency 1 --retry --retry-errors --timeout 10000 --skip 'README' --skip https://gcxgce.sharepoint.com/ --skip https://163gc.sharepoint.com/ ",
    "docs:guh": "lychee \"*.md\" \"*/*.md\" \"*/*/*.md\""
  },
  "devDependencies": {
    "@vuepress/bundler-vite": "2.0.0-rc.30",
    "@vuepress/theme-default": "2.0.0-rc.130",
    "linkinator": "^7.6.1",
    "markdown-link-check": "^3.11.2",
    "sass-embedded": "1.99.0",
    "vue": "3.5.34",
    "vuepress": "2.0.0-rc.30"
  },
  "dependencies": {
    "@gcds-core/components": "^1.0.0",
    "@gcds-core/css-shortcuts": "^1.1.0"
  }
}
